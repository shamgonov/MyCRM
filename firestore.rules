rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Вспомогательная функция: пользователь авторизован
    function isSignedIn() {
      return request.auth != null;
    }

    // Заявки: читают все авторизованные, пишут те, кто создал или назначен
    // (Для упрощения на этапе внедрения разрешаем запись всем авторизованным)
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }

    // Пользователи: свой профиль может читать/писать сам пользователь
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}