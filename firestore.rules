rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    match /orders/{id}    { allow read, write: if isSignedIn(); }
    match /users/{id}     { allow read, write: if isSignedIn(); }
    match /clients/{id}   { allow read, write: if isSignedIn(); }
    match /suppliers/{id} { allow read, write: if isSignedIn(); }
    match /tasks/{id}     { allow read, write: if isSignedIn(); }
    match /templates/{id} { allow read, write: if isSignedIn(); }
    match /priceList/{id} { allow read, write: if isSignedIn(); }
    match /settings/{id}  { allow read, write: if isSignedIn(); }
  }
}
